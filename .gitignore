# `.venv*/`, not `.venv/`: the swap to a standalone interpreter leaves `.venv.old`
# behind, and a rebuilt one may be `.venv-312`. Neither belongs in the repo, and a
# committed venv is a machine's absolute paths written into everyone's checkout.
.venv*/
venv/
*.egg-info/
build/
dist/

node_modules/

