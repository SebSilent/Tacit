__pycache__/
*.pyc
*.pyo
.pytest_cache/

# `.venv*/`, not `.venv/`: the swap to a standalone interpreter leaves `.venv.old`
# behind, and a rebuilt one may be `.venv-312`. Neither belongs in the repo, and a
# committed venv is a machine's absolute paths written into everyone's checkout.
.venv*/
venv/
*.egg-info/
build/
dist/

node_modules/

.tacit/
.env
*.log
sandbox/

# working notes, not for upload
PLAN.md
PLAN2.md

# design scratch: the OKLCH palette lab, the render probe and its screenshots.
# Tooling for an appearance pass, not part of the app, and never served.
.shots/

# a restore point taken before the frontend was rebuilt from scratch. Kept on disk
# on purpose -- it is the way back -- and kept out of the repo for the same reason:
# a second copy of every served file is a fork nobody meant to create.
.backups/static-*/

.DS_Store
Thumbs.db
